{
    "llvm-target": "i386-unknown-none",
    "arch": "x86",
    "os": "none",
    "target-pointer-width": 32,
    "data-layout": "e-m:e-p:32:32-i64:64-f80:32-n8:16:32-S128",
    "executables": true,
    "linker": "rust-lld",
    "linker-flavor": "ld.lld",
    "panic-strategy": "abort",
    "disable-redzone": true,
    "relocation-model": "static",
    "code-model": "kernel"
}